# --- Database ---------------------------------------------------------------
# Local docker-compose target (matches infra/docker-compose.yml).
# In Railway use the auto-injected `${{ Postgres.DATABASE_URL }}` reference.
DATABASE_URL=postgresql://ess:ess@localhost:5432/ess

# --- API ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# Generate strong random secrets in production (e.g. `openssl rand -hex 32`).
# Both must be at least 16 characters.
JWT_ACCESS_SECRET=change-me-please-change-me-please
JWT_REFRESH_SECRET=change-me-also-change-me-also-1234

# Token lifetimes (e.g. 15m, 1h, 30d)
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Comma-separated allow-list. Leave empty in dev (defaults to allow-all + credentials).
# In Railway production set to your web origin, e.g. https://ess-web.up.railway.app
CORS_ORIGINS=

# Refresh-cookie tuning.
# - COOKIE_SECURE must be true behind HTTPS in production.
# - Leave COOKIE_DOMAIN empty when API and web are on different domains
#   (e.g. *.up.railway.app is on the Public Suffix List and rejects shared cookies).
# - COOKIE_SAMESITE must be `none` when web and API are different sites/domains
#   so the refresh cookie is sent on cross-site fetches; defaults to `none` in
#   production and `lax` in development.
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# Set to true on the first prod boot to run prisma seed (or invoke the script manually instead).
SEED_ON_BOOT=false

# --- Web ---------------------------------------------------------------------
# Leave empty to use the Next.js dev proxy (/api-backend → 127.0.0.1:4000).
# In Railway set to the public API URL (e.g. https://ess-api.up.railway.app).
NEXT_PUBLIC_API_BASE=
