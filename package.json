{
  "name": "ess-platform",
  "private": true,
  "version": "1.0.0",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20.10",
    "pnpm": ">=9.12"
  },
  "scripts": {
    "postinstall": "pnpm --filter @ess/shared run build",
    "dev": "pnpm db:up && pnpm -r --parallel dev",
    "dev:web": "pnpm --filter @ess/web run dev",
    "dev:api": "pnpm --filter @ess/api run dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && pnpm format:check",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,css}\"",
    "test": "pnpm -r test",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @ess/api run db:migrate",
    "db:reset": "pnpm --filter @ess/api run db:reset",
    "db:seed": "pnpm --filter @ess/api run db:seed",
    "db:studio": "pnpm --filter @ess/api run db:studio"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "eslint": "9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "typescript": "5.6.3",
    "vitest": "^2.1.8"
  }
}
